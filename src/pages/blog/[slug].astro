---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { preset } from '../../config/site'
import type { Post } from '../../config/presets'
import type { GetStaticPaths } from 'astro'

export const getStaticPaths = (() => {
  return preset.posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }))
}) satisfies GetStaticPaths

interface Props {
  post: Post
}

const { post } = Astro.props
const formatted = new Date(post.date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})
---

<BaseLayout
  title={`${post.title} — ${preset.brand}`}
  description={post.description}
  path={`/blog/${post.slug}/`}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.title,
    description: post.description,
    datePublished: post.date,
    author: { '@type': 'Organization', name: preset.brand },
  }}
>
  <article class="section-tight">
    <div class="container">
      <div class="prose">
        <p class="eyebrow">Journal</p>
        <h1>{post.title}</h1>
        <p class="muted"><time datetime={post.date}>{formatted}</time> · {preset.brand}</p>
        <Fragment set:html={post.body} />
        <p><a href="/blog/">← All guides</a></p>
      </div>
    </div>
  </article>
</BaseLayout>
