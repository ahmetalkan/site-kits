---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageHeader from '../../components/PageHeader.astro'
import PostCard from '../../components/PostCard.astro'
import { preset } from '../../config/site'

const posts = [...preset.posts].sort((a, b) => b.date.localeCompare(a.date))
---

<BaseLayout
  title={`Blog — ${preset.brand}`}
  description={`Guides and notes from ${preset.brand}.`}
  path="/blog/"
>
  <PageHeader eyebrow="Journal" title="Guides and notes." intro={`Practical writing from ${preset.brand}.`} />
  <section class="section-tight">
    <div class="container">
      <div class="posts-grid">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>
</BaseLayout>
