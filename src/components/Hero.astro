---
import { preset, href } from '../config/site'
import Icon from './Icon.astro'

const { hero, stats } = preset

const note = {
  clinic: 'Independent listings · No paid rankings · Updated 2026',
  trade: 'Fixed-scope quotes · Permit-aware planning · Updated 2026',
  charter: 'No sponsored rankings · Direct operator quotes · Updated 2026',
}[preset.vertical]
---

<section class="hero">
  <div class="container hero-grid">
    <div>
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1>{hero.title}</h1>
      <p class="lede">{hero.body}</p>
      <div class="hero-actions">
        <a class="btn" href={href(hero.primaryHref)}>
          {hero.primaryCta}
          <Icon name="arrow" size={18} />
        </a>
        <a class="btn btn-secondary" href={href(hero.secondaryHref)}>{hero.secondaryCta}</a>
      </div>
      <p class="hero-note">{note}</p>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="hero-chip hero-chip-a">
        <strong>{stats[0]?.value}</strong>
        <span>{stats[0]?.label}</span>
      </div>
      <div class="hero-chip hero-chip-b">
        <strong>{stats[1]?.value}</strong>
        <span>{stats[1]?.label}</span>
      </div>
      <div class="hero-chip hero-chip-c">
        <strong>{stats[2]?.value}</strong>
        <span>{stats[2]?.label}</span>
      </div>
    </div>
  </div>
</section>
