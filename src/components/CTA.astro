---
import { preset } from '../config/site'
import Icon from './Icon.astro'

interface Props {
  title?: string
  body?: string
  cta?: string
  href?: string
}

const {
  title = preset.contact.title,
  body = preset.contact.body,
  cta = preset.hero.primaryCta,
  href = preset.hero.primaryHref,
} = Astro.props
---

<section class="section-tight">
  <div class="container">
    <div class="cta-band">
      <div>
        <h2>{title}</h2>
        <p>{body}</p>
      </div>
      <a class="btn" href={href}>
        {cta}
        <Icon name="arrow" size={18} />
      </a>
    </div>
  </div>
</section>
