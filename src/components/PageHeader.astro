---
interface Props {
  eyebrow?: string
  title: string
  intro?: string
}

const { eyebrow = 'Guide', title, intro } = Astro.props
---

<section class="page-header">
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    {intro && <p class="lede">{intro}</p>}
  </div>
</section>
